# Copy this file to .env in person2_backend/ (optional -- all values below
# are also the built-in defaults, so person2_backend runs fine with none of
# this set).

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to Vite's dev server origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
