# Copy this file to .env and fill in your values. Never commit the real .env.
#
# TWO SUPPORTED PROVIDERS — pick ONE:
#
# Option A: Anthropic (Claude) — requires paid credits, no free tier.
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=your_anthropic_api_key_here      (from console.anthropic.com/settings/keys)
#   LLM_MODEL=claude-sonnet-4-6
#
# Option B: Google Gemini — FREE tier, no credit card required.
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=your_gemini_api_key_here          (from aistudio.google.com/apikey)
#   LLM_MODEL=gemini-2.5-flash

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# PERSON1_MODE=mock (default) uses clients/mock_client.py's deterministic
# offline heuristics — no outbound LLM calls, no Gemini quota usage, no
# LLM_API_KEY required. Set PERSON1_MODE=real to call the real provider above.
PERSON1_MODE=mock

# Optional tuning
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=30
LLM_LOG_DIR=./logs

# Optional: comma-separated list of allowed frontend origins for api.py's CORS
# (defaults to http://localhost:5173,http://127.0.0.1:5173 — Vite's default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
